# Copy to sync.env on the server. Names only here; values never go in git.

# Same value as SYNC_SERVICE_TOKEN in gateway.env. Generate with: openssl rand -hex 32
ADOROUTER_SYNC_TOKEN=

# Marketplace m1: its address (https://...), the personal access token and
# numeric user ID from the account there, and an internal name for it.
M1_BASE_URL=
M1_ACCESS_TOKEN=
M1_USER_ID=
M1_PROVIDER_NAME=
