# Copy to .env on the server. Names only here: real values never enter Git.
# Generate secrets with: openssl rand -hex 32

# Which commits run. Change these to deploy or roll back.
GATEWAY_COMMIT=
SITE_COMMIT=

POSTGRES_PASSWORD=
REDIS_PASSWORD=
TUNNEL_TOKEN=

# Backups (scripts/backup.sh). Keep a copy of this key away from the server, or
# the backups can't be read when the server is gone.
BACKUP_AGE_RECIPIENT=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
