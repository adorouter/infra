# Copy to gateway.env on the server. See docs/gateway-settings.md for what each does.
# Losing these values invalidates every key, and the backups include a copy.

# Generate each of these with: openssl rand -hex 32
SESSION_SECRET=
CRYPTO_SECRET=
REGISTER_IP_HASH_KEY=
AUDIT_FINGERPRINT_KEY=
BFF_SERVICE_TOKEN=
ADO_FINGERPRINT_KEY=
# The sync's credential. Same value as ADOROUTER_SYNC_TOKEN in sync.env.
SYNC_SERVICE_TOKEN=

# These three must be base64. Generate each with: openssl rand -base64 32
TOKEN_KEY_PEPPER=
TOKEN_KEY_ENC_KEY=
CHANNEL_KEY_ENC_KEY=

# Not secret.
OAUTH_ALLOWED_REDIRECT_ORIGINS=https://adorouter.com

# The signup grant is off. Leaving this out turns it back on at $0.50.
ADO_SIGNUP_GRANT_USD=0

# Optional Discord webhook for the signup grant's daily limit.
ADO_ALERT_WEBHOOK_URL=
